# Wearer
SETU_USER_NAME=Your Name
SETU_LANGUAGE=en                     # en hi bn ta te gu kn ml mr pa od
SETU_CONTACTS={"family": "+91XXXXXXXXXX", "nurse": "+91XXXXXXXXXX"}

# Bolna voice agent (https://platform.bolna.ai)
BOLNA_API_KEY=
BOLNA_AGENT_ID=                      # from `setu create-agent`
BOLNA_FROM_NUMBER=                   # optional: your Plivo / Exotel number connected in Bolna
SETU_TELEPHONY=plivo                 # plivo | exotel

# Bridge for Bolna custom functions (expose with: cloudflared tunnel --url http://localhost:8787)
SETU_PUBLIC_URL=https://your-tunnel.trycloudflare.com
SETU_BRIDGE_TOKEN=change-me-long-random-string

# Speech
SARVAM_API_KEY=
SARVAM_SPEAKER=shubh
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=                   # the wearer's cloned voice
DEEPGRAM_API_KEY=

# LLM layer (any OpenAI-compatible endpoint), e.g. Sarvam:
LLM_BASE_URL=https://api.sarvam.ai/v2
LLM_API_KEY=
LLM_MODEL=sarvam-105b
