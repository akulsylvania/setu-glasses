{
  "agent_config": {
    "agent_name": "Setu relay (Hindi)",
    "agent_welcome_message": "{{opening_line}}",
    "webhook_url": "https://YOUR-BRIDGE.example.com/bolna/webhook",
    "call_summary_enabled": true,
    "tasks": [
      {
        "task_type": "conversation",
        "tools_config": {
          "llm_agent": {
            "agent_type": "simple_llm_agent",
            "agent_flow_type": "streaming",
            "llm_config": {
              "provider": "openai",
              "model": "gpt-5.4-mini",
              "max_tokens": 150,
              "temperature": 1
            }
          },
          "synthesizer": {
            "provider": "sarvam",
            "provider_config": {
              "voice": "Shubh",
              "voice_id": "shubh",
              "model": "bulbul:v3",
              "language": "hi",
              "speed": 1.0
            },
            "stream": true,
            "buffer_size": 250,
            "audio_format": "wav"
          },
          "transcriber": {
            "provider": "sarvam",
            "model": "saaras:v4",
            "language": "hi",
            "stream": true,
            "endpointing": 500,
            "context": "Phone call relayed for a person who answers through silent-speech glasses."
          },
          "input": {
            "provider": "plivo",
            "format": "wav"
          },
          "output": {
            "provider": "plivo",
            "format": "wav"
          },
          "api_tools": {
            "tools": [
              {
                "name": "ask_user",
                "description": "Call this whenever the other person asks the wearer a question or needs their decision. Pass the question in short, plain words, ideally as a yes/no question.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "question": {
                      "type": "string",
                      "description": "The question for the wearer."
                    },
                    "session": {
                      "type": "string",
                      "description": "The session id from your instructions."
                    }
                  },
                  "required": [
                    "question",
                    "session"
                  ]
                },
                "key": "custom_task",
                "value": {
                  "method": "POST",
                  "url": "https://YOUR-BRIDGE.example.com/bolna/ask_user",
                  "api_token": "Bearer SETU_BRIDGE_TOKEN",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "param": {
                    "question": "%(question)s",
                    "session": "%(session)s"
                  }
                },
                "pre_call_message": "Let me ask them."
              },
              {
                "name": "get_user_answer",
                "description": "Call this after ask_user returned status pending, to fetch the wearer's answer.",
                "parameters": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "string",
                      "description": "The session id from your instructions."
                    }
                  },
                  "required": [
                    "session"
                  ]
                },
                "key": "custom_task",
                "value": {
                  "method": "POST",
                  "url": "https://YOUR-BRIDGE.example.com/bolna/get_user_answer",
                  "api_token": "Bearer SETU_BRIDGE_TOKEN",
                  "headers": {
                    "Content-Type": "application/json"
                  },
                  "param": {
                    "session": "%(session)s"
                  }
                }
              }
            ],
            "tools_params": {
              "ask_user": {
                "method": "POST",
                "url": "https://YOUR-BRIDGE.example.com/bolna/ask_user",
                "api_token": "Bearer SETU_BRIDGE_TOKEN",
                "headers": {
                  "Content-Type": "application/json"
                },
                "param": {
                  "question": "%(question)s",
                  "session": "%(session)s"
                }
              },
              "get_user_answer": {
                "method": "POST",
                "url": "https://YOUR-BRIDGE.example.com/bolna/get_user_answer",
                "api_token": "Bearer SETU_BRIDGE_TOKEN",
                "headers": {
                  "Content-Type": "application/json"
                },
                "param": {
                  "session": "%(session)s"
                }
              }
            }
          }
        },
        "toolchain": {
          "execution": "parallel",
          "pipelines": [
            [
              "transcriber",
              "llm",
              "synthesizer"
            ]
          ]
        },
        "task_config": {
          "hangup_after_silence": 30,
          "call_terminate": 600
        }
      }
    ]
  },
  "agent_prompts": {
    "task_1": {
      "system_prompt": "You are Setu, a voice relay speaking on behalf of {{user_name}}, who cannot speak out loud right now\nand is answering through silent-speech glasses. Your session id is {{session_id}}.\n\nRules:\n- You only relay. Never answer for {{user_name}} from your own knowledge and never make up their reply.\n- Whenever the other person asks {{user_name}} anything or needs a decision, call ask_user with the question,\n  then say the returned \"say\" text, naturally, in the first person on their behalf (\"{{user_name}} says ...\").\n- If ask_user returns status \"pending\", tell the other person {{user_name}} is still answering, then call\n  get_user_answer. If it returns status \"none\", ask the other person to repeat or rephrase as a yes/no question.\n- Encourage yes/no questions: they are fastest for {{user_name}} to answer.\n- Keep every turn short. Speak {{language_name}}.\n- Context for this call: {{call_reason}}"
    }
  }
}
